{"source":[["Excel functions (by category), Microsoft Support","https://support.microsoft.com/en-us/excel/excel-functions-by-category"],["What's new in Excel 2024, Microsoft Support","https://support.microsoft.com/en-us/office/what-s-new-in-excel-2024-for-windows-and-mac-faee26b6-ad74-40a8-9304-aa6db716553f"],["Announcing new text and array functions, Microsoft Excel Blog","https://techcommunity.microsoft.com/blog/excelblog/announcing-new-text-and-array-functions/3186066"],["TRIMRANGE function, Microsoft Support","https://support.microsoft.com/en-us/excel/functions/trimrange-function"],["PERCENTOF function, Microsoft Support","https://support.microsoft.com/en-us/excel/functions/percentof-function"]],"families":["Lookup","Filter & sort","Text","Combine & reshape","Summarise","Logic & tidy formulas","Your own functions","AI & other"],"fns":[["XLOOKUP","Lookup","2021","=XLOOKUP(find, look_in, return, [if_not_found], [match_mode], [search_mode])","Finds a value in one column and returns the matching value from another column. Works left or right, exact by default.","=XLOOKUP(\"V002\", A2:A50, B2:B50, \"Not found\")","Global Pack Sdn Bhd","Use the 4th argument instead of wrapping in IFERROR.",{"cols":["A: VendorID","B: Name"],"rows":[["V001","ABC Supplies"],["V002","Global Pack Sdn Bhd"],["V003","Delta Freight"]],"res":"Global Pack Sdn Bhd"}],["XMATCH","Lookup","2021","=XMATCH(find, look_in, [match_mode], [search_mode])","Gives the position of a value in a list. Modern MATCH, exact by default.","=XMATCH(\"Mar\", B1:M1)","3","Pair with INDEX for two-way lookups.",{"cols":["B","C","D"],"rows":[["Jan","Feb","Mar"]],"res":"3"}],["FILTER","Filter & sort","2021","=FILTER(range, condition, [if_empty])","Returns only the rows that meet a condition, and updates by itself.","=FILTER(A2:D100, D2:D100>90, \"None\")","All invoices over 90 days, as a live list","Join conditions with * for AND, + for OR: (C2:C100=\"A\")*(D2:D100>90).",{"cols":["Invoice","Customer","Days"],"rows":[["INV-101","Ali","12"],["INV-102","Bina","95"],["INV-110","Citra","121"]],"res":[["INV-102","Bina","95"],["INV-110","Citra","121"]]}],["SORT","Filter & sort","2021","=SORT(range, [sort_column], [1 or -1])","Returns the range sorted. The source stays as it is.","=SORT(A2:B20, 2, -1)","Customers sorted by amount, biggest first","",{"cols":["Customer","Amount"],"rows":[["Bina","3,200"],["Ali","12,500"],["Citra","870"]],"res":[["Ali","12,500"],["Bina","3,200"],["Citra","870"]]}],["SORTBY","Filter & sort","2021","=SORTBY(range, by_range, [1 or -1], …)","Sorts a range by another column, or by several columns.","=SORTBY(A2:C50, C2:C50, -1, A2:A50, 1)","By amount high→low, then name A→Z","",{"cols":["Name","Amt"],"rows":[["Bina","3,200"],["Ali","12,500"]],"res":[["Ali","12,500"],["Bina","3,200"]]}],["UNIQUE","Filter & sort","2021","=UNIQUE(range, [by_col], [exactly_once])","Lists each item once. Set the 3rd argument TRUE to list items that appear only once.","=UNIQUE(B2:B500)","Each vendor listed once","Count them with =COUNTA(UNIQUE(B2:B500)).",{"cols":["Vendor"],"rows":[["ABC"],["TNB"],["ABC"],["XYZ"]],"res":[["ABC"],["TNB"],["XYZ"]]}],["SEQUENCE","Combine & reshape","2021","=SEQUENCE(rows, [cols], [start], [step])","Makes a list of numbers.","=SEQUENCE(12)","1, 2, 3 … 12","Month starts: =EDATE(DATE(2026,4,1), SEQUENCE(12,,0)).",{"cols":[],"rows":[],"res":[["1"],["2"],["3"],["…"],["12"]]}],["RANDARRAY","AI & other","2021","=RANDARRAY([rows], [cols], [min], [max], [whole])","Random numbers in a block. Useful for picking audit samples.","=RANDARRAY(5,1,1,500,TRUE)","5 random row numbers between 1 and 500","Changes on every recalculation. Paste as values to keep the sample.",{"cols":[],"rows":[],"res":[["17"],["204"],["388"],["41"],["299"]]}],["LET","Logic & tidy formulas","2021","=LET(name1, value1, …, result)","Name parts of a formula so it's shorter and faster.","=LET(s, SUM(C2:C50), c, SUM(D2:D50), (s-c)/s)","GP% e.g. 0.28","",{"cols":["Sales","Cost"],"rows":[["100","70"],["200","146"]],"res":"0.28"}],["IFS","Logic & tidy formulas","2019","=IFS(test1, result1, test2, result2, …)","Several IF checks without nesting.","=IFS(D2<=30,\"0-30\", D2<=60,\"31-60\", TRUE,\">60\")","31-60 (for 45 days)","Put TRUE last as the 'everything else' case.",{"cols":["D: Days"],"rows":[["45"]],"res":"31-60"}],["SWITCH","Logic & tidy formulas","2019","=SWITCH(value, match1, result1, …, [default])","Turns codes into names.","=SWITCH(A2, 1000,\"Company A\", 2000,\"Company B\", \"Other\")","Company A","",{"cols":["A: Code"],"rows":[["1000"]],"res":"Company A"}],["MAXIFS / MINIFS","Summarise","2019","=MAXIFS(max_range, criteria_range, criteria, …)","Largest or smallest value that meets conditions.","=MAXIFS(D:D, A:A, \"ABC\")","Largest ABC invoice","",{"cols":["A: Vendor","D: Amount"],"rows":[["ABC","500"],["ABC","2,100"],["TNB","900"]],"res":"2,100"}],["CONCAT","Text","2019","=CONCAT(text1, text2, …)","Joins text. Accepts whole ranges (CONCATENATE did not).","=CONCAT(A2, \"-\", B2)","1000-400100","",{"cols":["A: Co","B: Acct"],"rows":[["1000","400100"]],"res":"1000-400100"}],["TEXTJOIN","Text","2019","=TEXTJOIN(delimiter, ignore_empty, text…)","Joins a range with a separator, skipping blanks.","=TEXTJOIN(\", \", TRUE, A2:A6)","INV1, INV2, INV5","",{"cols":["A: Invoice"],"rows":[["INV1"],["INV2"],[""],["INV5"]],"res":"INV1, INV2, INV5"}],["TEXTBEFORE","Text","2024","=TEXTBEFORE(text, delimiter, [instance])","Text before a character or word.","=TEXTBEFORE(\"400100 - Freight\", \" - \")","400100","",{"cols":["Text"],"rows":[["400100 - Freight"]],"res":"400100"}],["TEXTAFTER","Text","2024","=TEXTAFTER(text, delimiter, [instance])","Text after a character or word.","=TEXTAFTER(\"400100 - Freight\", \" - \")","Freight","",{"cols":["Text"],"rows":[["400100 - Freight"]],"res":"Freight"}],["TEXTSPLIT","Text","2024","=TEXTSPLIT(text, col_delimiter, [row_delimiter])","Splits text into separate cells, like Text to Columns but live.","=TEXTSPLIT(\"A;B;C\", \";\")","A | B | C","",{"cols":["Text"],"rows":[["A;B;C"]],"res":[["A","B","C"]]}],["VSTACK","Combine & reshape","2024","=VSTACK(range1, range2, …)","Stacks ranges one under another.","=VSTACK(CoA!A2:D100, CoB!A2:D100)","One list from two sheets","Wrap in FILTER to drop blank rows.",{"cols":["Sheet","Invoice"],"rows":[["CoA","INV-1"],["CoB","INV-9"]],"res":[["INV-1"],["INV-9"]]}],["HSTACK","Combine & reshape","2024","=HSTACK(range1, range2, …)","Puts ranges side by side.","=HSTACK(A2:A10, D2:D10)","Two chosen columns together","",{"cols":["A","D"],"rows":[["Ali","12,500"]],"res":[["Ali","12,500"]]}],["TAKE","Combine & reshape","2024","=TAKE(range, rows, [cols])","Keeps the first (or last, with negative) rows.","=TAKE(SORT(A2:B100,2,-1), 10)","Top 10 by amount","",{"cols":["Customer","Amt"],"rows":[["Ali","12,500"],["Bina","3,200"],["Citra","870"]],"res":[["Ali","12,500"],["Bina","3,200"]]}],["DROP","Combine & reshape","2024","=DROP(range, rows, [cols])","Removes rows or columns from the start or end.","=DROP(A1:D100, 1)","Data without the header row","",{"cols":["Row 1 = header"],"rows":[["Customer"],["Ali"],["Bina"]],"res":[["Ali"],["Bina"]]}],["CHOOSECOLS / CHOOSEROWS","Combine & reshape","2024","=CHOOSECOLS(range, col_num1, …)","Picks only the columns (or rows) you want, in any order.","=CHOOSECOLS(A2:H100, 1, 5, 3)","Columns 1, 5 and 3","",{"cols":["1","2","3","5"],"rows":[["INV-1","Ali","Oct","500"]],"res":[["INV-1","500","Oct"]]}],["TOCOL / TOROW","Combine & reshape","2024","=TOCOL(range, [ignore])","Turns a block into one column (or row).","=TOCOL(B2:M5, 1)","All monthly values in one column, blanks skipped","",{"cols":["Apr","May"],"rows":[["10","20"],["30",""]],"res":[["10"],["20"],["30"]]}],["WRAPROWS / WRAPCOLS","Combine & reshape","2024","=WRAPROWS(vector, count)","Turns one long list into a block with N items per row.","=WRAPROWS(A1:A12, 3)","4 rows × 3 columns",""],["EXPAND","Combine & reshape","2024","=EXPAND(array, rows, [cols], [pad_with])","Makes an array bigger, filling extra cells.","=EXPAND(A1:B2, 3, 3, \"\")","3×3 block",""],["IMAGE","AI & other","2024","=IMAGE(url, [alt_text], [sizing])","Shows a picture from a web address inside a cell.","=IMAGE(\"https://…/logo.png\")","Logo in the cell","The picture must be online; may be blocked by IT."],["LAMBDA","Your own functions","2024","=LAMBDA(param1, …, calculation)","Build your own function and save it with a name (Name Manager).","Name FYPERIOD: =LAMBDA(d, MOD(MONTH(d)-4,12)+1)","=FYPERIOD(A2) → 2 for May","",{"cols":["A: Date"],"rows":[["15/05/2026"]],"res":"2"}],["MAP / BYROW / BYCOL","Your own functions","2024","=BYROW(range, LAMBDA(row, calc))","Run a LAMBDA on each item, row or column.","=BYROW(B2:M20, LAMBDA(r, SUM(r)))","Total per row, one formula","",{"cols":["Apr","May","Jun"],"rows":[["10","20","30"],["5","5","5"]],"res":[["60"],["15"]]}],["REDUCE / SCAN","Your own functions","2024","=SCAN(start, array, LAMBDA(acc, x, calc))","SCAN gives a running result; REDUCE gives the final one.","=SCAN(0, B2:B13, LAMBDA(a, x, a+x))","Running total","",{"cols":["Month","Sales"],"rows":[["Apr","100"],["May","120"],["Jun","90"]],"res":[["100"],["220"],["310"]]}],["MAKEARRAY / ISOMITTED","Your own functions","2024","=MAKEARRAY(rows, cols, LAMBDA(r, c, calc))","Build a table from a rule; ISOMITTED checks if an optional argument was left out.","=MAKEARRAY(3,3, LAMBDA(r,c, r*c))","Small times table",""],["GROUPBY","Summarise","365","=GROUPBY(row_fields, values, function)","A summary like a pivot table, made with a formula. Updates instantly.","=GROUPBY(B2:B500, D2:D500, SUM)","Total per customer + grand total","",{"cols":["Customer","Amount"],"rows":[["Ali","12,500"],["Bina","3,200"],["Ali","3,200"]],"res":[["Ali","15,700"],["Bina","3,200"],["Total","18,900"]]}],["PIVOTBY","Summarise","365","=PIVOTBY(row_fields, col_fields, values, function)","Pivot with rows and columns, as a formula.","=PIVOTBY(B2:B500, C2:C500, D2:D500, SUM)","Customer × month grid","",{"cols":["Cust","Month","Amt"],"rows":[["Ali","Oct","500"],["Ali","Nov","300"],["Bina","Oct","200"]],"res":[["","Oct","Nov"],["Ali","500","300"],["Bina","200",""]]}],["PERCENTOF","Summarise","365","=PERCENTOF(subset, all)","Share of the total. Handy inside GROUPBY.","=GROUPBY(B2:B500, D2:D500, PERCENTOF)","Each customer's % of sales","",{"cols":["Customer","Amount"],"rows":[["Ali","15,700"],["Bina","3,200"]],"res":[["Ali","83%"],["Bina","17%"]]}],["REGEXTEST / REGEXEXTRACT / REGEXREPLACE","Text","365","=REGEXEXTRACT(text, pattern)","Find, pull out or replace text that follows a pattern.","=REGEXEXTRACT(A2, \"INV\\d+\")","INV20456 from a bank description","",{"cols":["A: Bank text"],"rows":[["IBG CR ABC SDN BHD INV20456 REF"]],"res":"INV20456"}],["TRIMRANGE","Combine & reshape","365","=TRIMRANGE(range) or A2:.D5000","Cuts empty rows/columns off the edges of a range, so whole-column formulas stay fast.","=SUM(D2:.D10000)","Sum of only the filled rows","The dot reference A1:.D100 trims trailing blanks.",{"cols":["D: Amount"],"rows":[["500"],["300"],["(blank to row 10,000)"]],"res":"800"}],["TRANSLATE / DETECTLANGUAGE","Text","365","=TRANSLATE(text, [from], [to])","Translate text in a cell; detect its language.","=TRANSLATE(A2, \"en\", \"ms\")","English text in Malay","Uses Microsoft's online translation service.",{"cols":["A: Text"],"rows":[["Payment received"]],"res":"Bayaran diterima"}],["STOCKHISTORY","AI & other","365","=STOCKHISTORY(stock, start, [end], …)","Past prices for a stock or currency pair.","=STOCKHISTORY(\"USD/MYR\", DATE(2026,10,1), DATE(2026,10,31))","Daily USD/MYR rates for October","Market data, not your bank's booking rate."],["COPILOT","AI & other","365c","=COPILOT(prompt, [context…])","Ask AI inside a formula to classify or summarise text.","=COPILOT(\"Category: Travel, Utilities or Repairs\", A2)","Utilities","Results can change; paste as values when final.",{"cols":["A: Description"],"rows":[["TNB bill Oct"]],"res":"Utilities"}],["PY","AI & other","365","=PY( … ) or Formulas › Insert Python","Run Python code in a cell for advanced analysis.","=PY(xl(\"A1:D500\", headers=True).describe())","Summary statistics","Runs in Microsoft's cloud; IT may turn it off."]],"swaps":[["VLOOKUP / HLOOKUP","XLOOKUP","Looks left or right, doesn't break when columns are inserted, exact match by default, built-in 'not found' text.","=VLOOKUP(A2, Vendors!A:D, 4, FALSE)","=XLOOKUP(A2, Vendors!A:A, Vendors!D:D, \"Not found\")","2021"],["INDEX + MATCH","XLOOKUP (or INDEX + XMATCH)","One function instead of two; easier to read.","=INDEX(C:C, MATCH(A2, B:B, 0))","=XLOOKUP(A2, B:B, C:C)","2021"],["MATCH","XMATCH","Exact match by default; can search from the bottom.","=MATCH(A2, B:B, 0)","=XMATCH(A2, B:B)","2021"],["IFERROR(VLOOKUP(…), \"\")","XLOOKUP with if_not_found","Hides only 'not found', not every other error.","=IFERROR(VLOOKUP(A2,T,2,0),\"-\")","=XLOOKUP(A2, T[ID], T[Name], \"-\")","2021"],["Nested IF","IFS or SWITCH","No pile of brackets; easy to read and change.","=IF(D2<=30,\"0-30\",IF(D2<=60,\"31-60\",\">60\"))","=IFS(D2<=30,\"0-30\", D2<=60,\"31-60\", TRUE,\">60\")","2019"],["CONCATENATE or &","CONCAT / TEXTJOIN","Join whole ranges, with a separator, skipping blanks.","=A2&\", \"&A3&\", \"&A4","=TEXTJOIN(\", \", TRUE, A2:A4)","2019"],["MAX(IF(…)) with Ctrl+Shift+Enter","MAXIFS / MINIFS","Normal formula, no special keys.","{=MAX(IF(A:A=\"ABC\", D:D))}","=MAXIFS(D:D, A:A, \"ABC\")","2019"],["LEFT/MID/FIND to split text","TEXTBEFORE / TEXTAFTER","No counting characters.","=LEFT(A2, FIND(\" - \", A2)-1)","=TEXTBEFORE(A2, \" - \")","2024"],["Text to Columns (manual)","TEXTSPLIT","Updates automatically when the text changes.","Data › Text to Columns each month","=TEXTSPLIT(A2, \" - \")","2024"],["Remove Duplicates (manual)","UNIQUE","Live list; original data untouched.","Copy column › Remove Duplicates","=UNIQUE(B2:B500)","2021"],["AutoFilter + copy-paste","FILTER","Result updates itself; no copying.","Filter > 90 days, copy, paste to new sheet","=FILTER(A2:D500, D2:D500>90)","2021"],["Sort button (manual)","SORT / SORTBY","Sorted copy that stays sorted.","Data › Sort every time data changes","=SORT(A2:C50, 3, -1)","2021"],["Copy-paste sheets together","VSTACK","One live formula stacks all sheets.","Copy CoA, paste under CoB…","=VSTACK(CoA!A2:D100, CoB!A2:D100)","2024"],["PivotTable + Refresh","GROUPBY / PIVOTBY","No Refresh needed; formula result.","Insert › PivotTable, then Refresh","=GROUPBY(B2:B500, D2:D500, SUM)","365"],["SUMPRODUCT for % share","PERCENTOF","Clearer for share-of-total.","=D2/SUM(D:D)","=PERCENTOF(D2, D2:D500)","365"],["OFFSET / COUNTA dynamic ranges","Tables, or TRIMRANGE / dot references","No slow, fragile OFFSET.","=SUM(OFFSET(D2,0,0,COUNTA(D:D)-1))","=SUM(D2:.D10000)","365"],["Typing 1, 2, 3 and dragging","SEQUENCE","Numbers made by formula.","Type 1, 2, drag down","=SEQUENCE(12)","2021"],["Repeating the same part in a formula","LET","Calculate once, reuse by name; faster.","=IF(SUM(B:B)=0,0,C2/SUM(B:B))","=LET(t, SUM(B:B), IF(t=0, 0, C2/t))","2021"],["SUBSTITUTE chains to clean text","REGEXREPLACE","One pattern instead of many SUBSTITUTEs.","=SUBSTITUTE(SUBSTITUTE(A2,\"-\",\"\"),\" \",\"\")","=REGEXREPLACE(A2, \"[- ]\", \"\")","365"],["Same long formula copied in many files","LAMBDA (named)","Write once, use by name; fix in one place.","=MOD(MONTH(A2)-4,12)+1 everywhere","=FYPERIOD(A2)","2024"]]}